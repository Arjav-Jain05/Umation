# Local-only Configuration (No Cloud Keys)
WEIGHTS_DIR=D:\Open_Source_Weights
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODELS=D:\Open_Source_Weights\ollama
HF_HOME=D:\Open_Source_Weights\huggingface
HF_HUB_CACHE=D:\Open_Source_Weights\huggingface\hub
MODELSCOPE_CACHE=D:\Open_Source_Weights\modelscope
TORCH_HOME=D:\Open_Source_Weights\torch
HF_HUB_OFFLINE=1

# Layer 0 Whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8_float16
WHISPER_LANGUAGE=auto

# Local Models (Ollama)
LLM_PROPOSER_MODEL_1=qwen3.5:9b
LLM_PROPOSER_MODEL_2=gemma4:e4b
LLM_CRITIC_MODEL=gemma4:e4b
LLM_RERANK_MODELS=qwen3.5:9b,gemma4:e4b
LLM_METADATA_MODEL=gemma4:e4b

# Pipeline & Thresholds
CLIP_MIN_SCORE=65
PIPELINE_PRESET=Balanced
LAYER_SENSORS_ENABLED=true
LAYER_VISUAL_ENABLED=true
LAYER_THUMBNAILS_ENABLED=true

# Storage & Network
PROJECT_DOMAIN=gta6
DATA_DIR=./data
OUTPUT_DIR=./output
HOST=127.0.0.1
PORT=8000
MIN_FREE_GB=30
AUTO_UPDATE_YTDLP=true
