# Local-only Configuration (No Cloud Keys)
WEIGHTS_DIR=./weights
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODELS=./weights/ollama
HF_HOME=./weights/huggingface
HF_HUB_CACHE=./weights/huggingface/hub
MODELSCOPE_CACHE=./weights/modelscope
TORCH_HOME=./weights/torch
HF_HUB_OFFLINE=0

# Layer 0 Whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8_float16
WHISPER_LANGUAGE=auto

# Local Models (Ollama)
LLM_PROPOSER_MODEL_1=qwen3.5:9b
LLM_PROPOSER_MODEL_2=qwen3.5:9b
LLM_CRITIC_MODEL=qwen3.5:9b
LLM_RERANK_MODELS=qwen3.5:9b
LLM_METADATA_MODEL=qwen3.5:9b

# Pipeline & Thresholds
CLIP_MIN_SCORE=65
PIPELINE_PRESET=Balanced
LAYER_SENSORS_ENABLED=true
LAYER_VISUAL_ENABLED=true
LAYER_THUMBNAILS_ENABLED=true

# Storage & Network
PROJECT_DOMAIN=general
DATA_DIR=./data
OUTPUT_DIR=./output
HOST=127.0.0.1
PORT=8000
MIN_FREE_GB=30
AUTO_UPDATE_YTDLP=true
